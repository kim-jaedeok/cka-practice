#!/usr/bin/env bash
# cka — CKA 시험 연습 CLI
set -uo pipefail

CKA_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export CKA_ROOT
source "$CKA_ROOT/lib/common.sh"
source "$CKA_ROOT/lib/question-runtime.sh"

DOMAIN_ORDER=(troubleshooting cluster-architecture services-networking workloads-scheduling storage)

# 모의고사 준비/진행/채점 중에는 학습용 명령으로 문제 상태를 보거나 고칠 수 없다.
# 상태 읽기/잠금 판정은 lib/common.sh의 공통 helper를 사용한다.
deny_if_exam_locked() {
  if exam_actions_locked; then
    die "모의고사가 $(exam_state_get) 상태입니다. 시험 중에는 start/grade/solution/reset/cleanup 및 클러스터 변경을 사용할 수 없습니다."
  fi
  supervised_exam_actions_locked || return 0
  die "감독형 SSH 모의고사가 활성 상태입니다. 먼저 'cka exam-ssh cleanup'을 실행하세요."
}

usage() {
  cat <<EOF

${C_BLD}cka — CKA 시험 연습 CLI${C_RST}

  cka list [domain]        문제 목록과 진행 상태
  cka start <id>           문제 환경 구성 + 지문 표시
  cka question <id>        지문 다시 보기
  cka grade <id>           채점 (기준별 부분 점수)
  cka solution <id>        정답지 + 한국어 해설
  cka reset <id>           문제 환경 재설정 (다시 풀기)
  cka init <id>            reset과 동일한 문제 초기화
  cka cleanup <id>         문제 환경 명시적 정리 (일회용 셀 포함)
  cka exam [status|question <n>|finish|abort]
                           모의고사 (17문제 / 2시간 / 성적표)
  cka exam-ssh <command>   systemd 감독형 지정-host SSH 모의고사 (opt-in)
  cka web [port]           웹 스플릿 뷰 (왼쪽 지문 / 오른쪽 터미널, 기본 7681)
  cka cluster up|down|reset|doctor|status
                            연습용 kind 인프라 관리
                            (down: 관리 셀+공유 클러스터, doctor: 애드온 점검·복구)

  domain: troubleshooting | cluster-architecture | services-networking
        | workloads-scheduling | storage
EOF
}

show_question() {
  local id="$1" qdir title points domain
  qdir="$(qdir_of "$id")" || die "존재하지 않는 문제: $id"
  title="$(meta_get "$qdir" title)"
  points="$(meta_get "$qdir" points)"
  domain="$(meta_get "$qdir" domain)"
  printf '\n%s\n' "${C_BLD}═══════════════════════════════════════════════════════════════${C_RST}"
  printf '%s\n' "${C_BLD} $id | $domain | $points points | $title${C_RST}"
  printf '%s\n\n' "${C_BLD}═══════════════════════════════════════════════════════════════${C_RST}"
  cat "$qdir/question.md"
  printf '\n'
  printf '연습 파일 작업 폴더: %s/%s\n' "$CKA_WORK_DIR" "$id"
  printf '  cd %q\n' "$CKA_WORK_DIR/$id"
  printf '문제 시작 후 저장소 루트에 새로 만든 파일도 reset/cleanup 및 cluster down/reset 시 정리됩니다.\n'
}

cmd_list() {
  local filter="${1:-}" d qdir id title pts st shown=0
  printf '\n%-7s %-22s %-4s %-16s %s\n' "ID" "DOMAIN" "PTS" "STATUS" "TITLE"
  printf '%s\n' "──────────────────────────────────────────────────────────────────────────"
  for d in "${DOMAIN_ORDER[@]}"; do
    if [ -n "$filter" ] && [ "$d" != "$filter" ]; then continue; fi
    for qdir in "$CKA_ROOT/questions/$d"/*/; do
      [ -d "$qdir" ] || continue
      id="$(basename "$qdir")"
      title="$(meta_get "$qdir" title)"
      pts="$(meta_get "$qdir" points)"
      st="$(state_get "$id")"
      st="$(printf '%-16s' "$st")"   # 색상 코드 삽입 전에 폭을 맞춘다
      case "$st" in
        graded:*) st="${C_GRN}${st}${C_RST}" ;;
        started*) st="${C_YLW}${st}${C_RST}" ;;
      esac
      printf '%-7s %-22s %-4s %s %s\n' "$id" "$d" "$pts" "$st" "$title"
      shown=$((shown + 1))
    done
  done
  [ "$shown" -eq 0 ] && warn "표시할 문제가 없습니다."
  printf '\n'
}

# 애드온 상태를 점검하고 빠진 것만 복구한다 (읽기 전용 코어 점검 포함)
cmd_doctor() {
  _wait_api
  printf '\n%s\n' "${C_BLD}── cka cluster doctor ──────────────────────────────${C_RST}"

  # 코어(자가치유 대상 아님) — 상태만 보고한다
  local n_ready n_total
  n_ready="$(kctx get nodes --no-headers 2>/dev/null | grep -c ' Ready ')"
  n_total="$(kctx get nodes --no-headers 2>/dev/null | wc -l | tr -d ' ')"
  if [ "${n_ready:-0}" = "${n_total:-0}" ] && [ "${n_total:-0}" -gt 0 ]; then
    ok "nodes Ready ($n_ready/$n_total)"
  else
    warn "nodes Ready ($n_ready/$n_total) — 노드 상태 확인 필요"
  fi
  if kctx -n kube-system get deploy coredns >/dev/null 2>&1; then ok "coredns"; else warn "coredns 없음"; fi
  if kctx get sc >/dev/null 2>&1 && [ -n "$(kctx get sc --no-headers 2>/dev/null)" ]; then ok "StorageClass"; else warn "StorageClass 없음"; fi
  if command -v helm >/dev/null 2>&1; then ok "helm ($(helm version --short 2>/dev/null))"; else warn "helm PATH에 없음 (바이너리는 ~/.local/bin/helm 일 수 있음)"; fi
  if ssh_wrapper_ok; then
    if ensure_shell_path; then
      ok "ssh 래퍼 (~/.bashrc PATH 등록 — 새 셸부터 'ssh cka-worker' 사용 가능)"
    else
      ok "ssh 래퍼 (PATH 등록됨)"
    fi
  else
    warn "bin/ssh 래퍼 실행 불가 — 'chmod +x bin/ssh' 후 다시 시도하세요."
  fi
  if node_editors_ok; then
    ok "노드 편집기 (vim·nano)"
  else
    warn "노드 편집기 없음 → 설치"
    installed="$(install_node_editors)"
    [ "${installed:-0}" -gt 0 ] && ok "노드 편집기 설치 완료 (${installed}개 노드)" \
      || warn "노드 편집기 설치 실패 — 노드에서 sed/docker cp로 대체 가능."
  fi
  if node_etcdctl_ok; then
    ok "control plane etcdctl·etcdutl"
  else
    warn "control plane에 etcdctl 없음 → 설치"
    if install_node_etcdctl; then
      ok "etcdctl·etcdutl 설치 완료 (ssh $(cka_cp_node) 후 바로 사용)"
    else
      warn "etcdctl 설치 실패 — ca-03/ca-04는 etcd 파드 exec으로 대체 가능."
    fi
  fi

  # 자가치유 대상 애드온 — 점검 후 빠진 것만 복구
  printf '%s\n' "──────────────────────────────────────────────────"
  local entry key human repaired=0
  for entry in "${CKA_ADDONS[@]}"; do
    key="${entry%%|*}"; human="${entry#*|}"
    if "addon_ok_$key"; then
      ok "$human"
    else
      warn "$human 없음 → 재설치"
      if "addon_install_$key" >/dev/null 2>&1 && "addon_wait_$key"; then
        ok "$human 재설치 완료"; repaired=$((repaired + 1))
      else
        err "$human 재설치 실패 — 'cka cluster up' 을 직접 실행해 보세요."
      fi
    fi
  done
  printf '%s\n' "──────────────────────────────────────────────────"
  if [ "$repaired" -eq 0 ]; then
    ok "모든 애드온 정상. 복구할 항목 없음."
  else
    ok "애드온 $repaired건 복구 완료."
  fi
  printf '\n'
}

cmd_cluster_down() (
  set -uo pipefail
  deny_if_exam_locked
  _cloud_provider_kind_validate_cluster_name "$CKA_CLUSTER_NAME" \
    || die "공유 KIND cluster 이름이 안전하지 않습니다: $CKA_CLUSTER_NAME"
  [ "$CKA_CONTEXT" = "kind-$CKA_CLUSTER_NAME" ] \
    || die "공유 cluster 이름과 kubectl context가 일치하지 않아 정리를 중단합니다: $CKA_CLUSTER_NAME / $CKA_CONTEXT"
  _question_runtime_load_cell_library \
    || die "일회용 셀 정리 기능을 불러오지 못했습니다."
  CKA_ENABLE_DISPOSABLE_CELLS="${CKA_ENABLE_DISPOSABLE_CELLS:-1}"
  cell_feature_enabled \
    || die "일회용 셀 전체 정리에는 CKA_ENABLE_DISPOSABLE_CELLS=1 이 필요합니다."
  _cell_lock \
    || die "일회용 셀 lifecycle lock을 획득하지 못해 공유 클러스터 삭제를 중단합니다."
  _cell_cleanup_all_managed_locked \
    || die "관리 중인 일회용 문제 환경을 안전하게 정리하지 못해 공유 클러스터 삭제를 중단합니다."
  cloud_provider_kind_cleanup_cluster_loadbalancers "$CKA_CLUSTER_NAME" \
    || die "클러스터 삭제 전 LoadBalancer Service/container 정리에 실패했습니다."
  kind delete cluster --name "$CKA_CLUSTER_NAME" \
    || die "kind 클러스터 삭제에 실패했습니다."
  workdir_clear_all \
    || die "클러스터는 삭제됐지만 문제 작업 파일 정리에 실패했습니다."
  practice_files cleanup-all \
    || die "클러스터는 삭제됐지만 저장소의 연습 파일 정리에 실패했습니다."
  cloud_provider_kind_stop_if_no_clusters \
    || die "클러스터는 삭제됐지만 소유한 Cloud Provider KIND를 안전하게 종료하지 못했습니다."
)

cmd_cluster() {
  case "${1:-status}" in
    up)
      deny_if_exam_locked
      bash "$CKA_ROOT/cluster/setup-cluster.sh"
      ;;
    down)   cmd_cluster_down ;;
    reset)
      deny_if_exam_locked
      bash "$CKA_ROOT/cluster/reset-cluster.sh"
      ;;
    doctor)
      deny_if_exam_locked
      cmd_doctor
      ;;
    status)
      require_cluster_readonly
      kctx get nodes
      printf '\n'
      kctx get pods -n kube-system -o wide | head -20
      kctx get pods -n cka-system 2>/dev/null || true
      ;;
    *) die "cka cluster up|down|reset|doctor|status" ;;
  esac
}

cmd_exam_entry() {
  local action="${1:-start}"
  [ "$action" != start ] || deny_if_exam_locked
  bash "$CKA_ROOT/exam/mock-exam.sh" "$@"
}

cmd_exam_ssh_entry() {
  local action="${1:-help}"
  [ "$action" != prepare ] || deny_if_exam_locked
  bash "$CKA_ROOT/exam/supervised-exam.sh" "$@"
}

infrastructure_gate_mode() { # <cka argv...>; prints wait|nowait|none
  local command="${1:-help}" action="${2:-}"
  case "$command" in
    start|grade|solution|reset|init|cleanup) printf '%s\n' nowait ;;
    cluster)
      case "${action:-status}" in
        down) printf '%s\n' wait ;;
        up|reset|doctor) printf '%s\n' nowait ;;
        *) printf '%s\n' none ;;
      esac
      ;;
    exam)
      case "${action:-start}" in
        start) printf '%s\n' nowait ;;
        *) printf '%s\n' none ;;
      esac
      ;;
    exam-ssh)
      case "${action:-help}" in
        prepare) printf '%s\n' nowait ;;
        *) printf '%s\n' none ;;
      esac
      ;;
    *) printf '%s\n' none ;;
  esac
}

infrastructure_gate_parent_holds_lock() {
  local parent_comm="" fd_path
  [ "${CKA_INFRA_GATE_ACTIVE:-0}" = 1 ] || return 1
  [ "${CKA_INFRA_GATE_PARENT_PID:-}" = "$PPID" ] || return 1
  IFS= read -r parent_comm < "/proc/$PPID/comm" 2>/dev/null || return 1
  [[ "$parent_comm" = python3* ]] || return 1
  for fd_path in "/proc/$PPID/fd/"*; do
    [ -e "$fd_path" ] || continue
    [ "$fd_path" -ef "$CKA_INFRA_LOCK_FILE" ] && return 0
  done
  return 1
}

# Re-exec mutating public commands below the signal-forwarding lock guardian.
# Production calls always converge on one UID-scoped path. Tests may opt into
# an isolated /tmp root explicitly; ordinary environment overrides are ignored.
if [ "${CKA_INFRA_LOCK_TEST_OVERRIDE:-0}" != 1 ]; then
  CKA_INFRA_LOCK_ROOT="$CKA_INFRA_LOCK_CANONICAL_ROOT"
  CKA_INFRA_LOCK_FILE="${CKA_INFRA_LOCK_ROOT%/}/infrastructure.lock"
  unset CKA_INFRA_LOCK_ALLOW_NON_NATIVE_STATE
fi
infra_gate_is_active=0
infrastructure_gate_parent_holds_lock && infra_gate_is_active=1
unset CKA_INFRA_GATE_ACTIVE CKA_INFRA_GATE_PARENT_PID
if [ "$infra_gate_is_active" -eq 0 ]; then
  infra_gate_mode="$(infrastructure_gate_mode "$@")" \
    || die "infrastructure gate mode를 결정하지 못했습니다."
  if [ "$infra_gate_mode" != none ]; then
    infrastructure_lock_exec "$infra_gate_mode" bash "$CKA_ROOT/cka" "$@"
    exit $?
  fi
fi

cmd="${1:-help}"
shift || true

case "$cmd" in
  list) cmd_list "${1:-}" ;;
  start)
    [ $# -ge 1 ] || die "사용법: cka start <id>"
    deny_if_exam_locked
    qdir="$(qdir_of "$1")" || die "존재하지 않는 문제: $1"
    info "문제 환경 구성 중: $1 (몇 초에서 1~2분 정도 걸릴 수 있습니다)"
    question_runtime_start "$1" "$qdir" || die "환경 구성 실패: $1"
    state_set "$1" started
    show_question "$1"
    ;;
  question)
    [ $# -ge 1 ] || die "사용법: cka question <id>"
    show_question "$1"
    ;;
  grade)
    [ $# -ge 1 ] || die "사용법: cka grade <id>"
    deny_if_exam_locked
    qdir="$(qdir_of "$1")" || die "존재하지 않는 문제: $1"
    question_runtime_grade "$1" "$qdir" || err "채점 실행 실패: $1"
    ;;
  solution)
    [ $# -ge 1 ] || die "사용법: cka solution <id>"
    deny_if_exam_locked
    qdir="$(qdir_of "$1")" || die "존재하지 않는 문제: $1"
    printf '\n%s\n\n' "${C_BLD}── $1 정답지 ──────────────────────────────────────────────${C_RST}"
    cat "$qdir/answer.md"
    printf '\n'
    ;;
  reset|init)
    [ $# -ge 1 ] || die "사용법: cka reset <id>"
    deny_if_exam_locked
    qdir="$(qdir_of "$1")" || die "존재하지 않는 문제: $1"
    info "문제 환경 재설정 중: $1"
    question_runtime_reset "$1" "$qdir" || die "재설정 실패: $1"
    state_set "$1" started
    ok "재설정 완료. 'cka question $1' 로 지문을 다시 볼 수 있습니다."
    printf '연습 파일 작업 폴더: %s/%s\n' "$CKA_WORK_DIR" "$1"
    printf '저장소 루트에 새로 만드는 파일도 이번 문제의 정리 대상에 포함됩니다.\n'
    ;;
  cleanup)
    [ $# -ge 1 ] || die "사용법: cka cleanup <id>"
    deny_if_exam_locked
    qdir="$(qdir_of "$1")" || die "존재하지 않는 문제: $1"
    info "문제 환경 정리 중: $1"
    question_runtime_cleanup "$1" "$qdir" || die "환경 정리 실패: $1"
    state_clear "$1"
    ok "문제 환경 정리 완료: $1"
    ;;
  exam) cmd_exam_entry "$@" ;;
  exam-ssh) cmd_exam_ssh_entry "$@" ;;
  web) bash "$CKA_ROOT/web/serve.sh" "$@" ;;
  cluster) cmd_cluster "${1:-status}" ;;
  help|--help|-h) usage ;;
  *) err "알 수 없는 명령: $cmd"; usage; exit 1 ;;
esac
