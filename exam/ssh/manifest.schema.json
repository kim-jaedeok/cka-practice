{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cka-practice.local/schemas/ssh-supervisor-manifest-v1.json",
  "title": "CKA SSH supervisor immutable run manifest",
  "type": "object",
  "additionalProperties": false,
  "dependentRequired": {
    "form": ["external_network"],
    "external_network": ["form"]
  },
  "required": [
    "schema_version",
    "run_id",
    "run_nonce",
    "created_at_epoch",
    "deadline_epoch",
    "duration_seconds",
    "boot_id",
    "engine",
    "timer_proof_nonce",
    "guard_proof_nonce",
    "objects",
    "answer_allowlist",
    "policy"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "run_id": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,30}[a-z0-9])?$"
    },
    "run_nonce": { "$ref": "#/$defs/hex64" },
    "created_at_epoch": { "type": "integer", "minimum": 1 },
    "deadline_epoch": { "type": "integer", "minimum": 1 },
    "duration_seconds": { "type": "integer", "minimum": 1, "maximum": 28800 },
    "boot_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "command_timeout_seconds"],
      "properties": {
        "path": { "type": "string", "pattern": "^/" },
        "sha256": { "$ref": "#/$defs/hex64" },
        "command_timeout_seconds": { "type": "number", "exclusiveMinimum": 0, "maximum": 30 }
      }
    },
    "timer_proof_nonce": { "$ref": "#/$defs/hex64" },
    "guard_proof_nonce": { "$ref": "#/$defs/hex64" },
    "objects": {
      "type": "object",
      "additionalProperties": false,
      "required": ["network", "target", "base"],
      "properties": {
        "network": { "$ref": "#/$defs/network" },
        "target": { "$ref": "#/$defs/container" },
        "base": { "$ref": "#/$defs/container" }
      }
    },
    "answer_allowlist": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question_id", "file_name"],
        "properties": {
          "question_id": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$" },
          "file_name": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" }
        }
      }
    },
    "external_network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "driver", "internal", "labels_sha256"],
      "properties": {
        "id": { "$ref": "#/$defs/hex64" },
        "name": { "type": "string", "minLength": 1 },
        "driver": { "type": "string", "minLength": 1 },
        "internal": { "type": "boolean" },
        "labels_sha256": { "$ref": "#/$defs/hex64" }
      }
    },
    "form": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "source_manifest_sha256",
        "active_question",
        "questions",
        "file_count",
        "total_bytes",
        "bundle_sha256"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "source_manifest_sha256": { "$ref": "#/$defs/hex64" },
        "active_question": { "$ref": "#/$defs/questionId" },
        "questions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": { "$ref": "#/$defs/formQuestion" }
        },
        "file_count": { "type": "integer", "minimum": 3, "maximum": 2000 },
        "total_bytes": { "type": "integer", "minimum": 1, "maximum": 67108864 },
        "bundle_sha256": { "$ref": "#/$defs/hex64" }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seal_order",
        "objects_created_stopped",
        "candidate_has_engine_socket",
        "candidate_has_repository_mount",
        "candidate_has_grader_secret",
        "max_answer_file_bytes",
        "max_answer_total_bytes"
      ],
      "properties": {
        "seal_order": {
          "type": "array",
          "prefixItems": [{ "const": "target" }, { "const": "base" }],
          "items": false
        },
        "objects_created_stopped": { "const": true },
        "candidate_has_engine_socket": { "const": false },
        "candidate_has_repository_mount": { "const": false },
        "candidate_has_grader_secret": { "const": false },
        "max_answer_file_bytes": { "type": "integer", "minimum": 1, "maximum": 8388608 },
        "max_answer_total_bytes": { "type": "integer", "minimum": 1, "maximum": 33554432 }
      }
    }
  },
  "$defs": {
    "hex64": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "questionId": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$" },
    "relativeInput": { "type": "string", "pattern": "^[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$" },
    "dockerImageId": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "labels": {
      "type": "object",
      "additionalProperties": { "type": "string" },
      "required": [
        "org.cka-practice.ssh-supervisor.run",
        "org.cka-practice.ssh-supervisor.nonce"
      ]
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "labels"],
      "properties": {
        "id": { "$ref": "#/$defs/hex64" },
        "labels": { "$ref": "#/$defs/labels" }
      }
    },
    "container": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "image_id", "labels", "role"],
      "properties": {
        "id": { "$ref": "#/$defs/hex64" },
        "image_id": { "$ref": "#/$defs/dockerImageId" },
        "labels": { "$ref": "#/$defs/labels" },
        "role": { "enum": ["target", "base"] }
      }
    },
    "formQuestion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question_id", "kubeconfig_sha256", "kubeconfig_size", "work_files"],
      "properties": {
        "question_id": { "$ref": "#/$defs/questionId" },
        "kubeconfig_sha256": { "$ref": "#/$defs/hex64" },
        "kubeconfig_size": { "type": "integer", "minimum": 1, "maximum": 8388608 },
        "work_files": {
          "type": "array",
          "maxItems": 2000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256", "size"],
            "properties": {
              "path": { "$ref": "#/$defs/relativeInput" },
              "sha256": { "$ref": "#/$defs/hex64" },
              "size": { "type": "integer", "minimum": 0, "maximum": 8388608 }
            }
          }
        }
      }
    }
  }
}
