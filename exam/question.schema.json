{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cka-practice.local/schemas/question.schema.json",
  "title": "cka-practice question metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "domain", "points", "minutes"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(st|wl|sn|ca|ts)-[0-9]{2}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "domain": {
      "enum": [
        "storage",
        "workloads-scheduling",
        "services-networking",
        "cluster-architecture",
        "troubleshooting"
      ]
    },
    "points": {
      "type": "integer",
      "minimum": 1
    },
    "minutes": {
      "type": "integer",
      "minimum": 1
    },
    "environment": {
      "enum": [
        "shared-kind",
        "kubeadm-bootstrap",
        "kubeadm-ha",
        "kubeadm-upgrade",
        "operator-cell",
        "gateway-cell",
        "csi-cell"
      ],
      "default": "shared-kind"
    },
    "mode": {
      "enum": ["shared", "individual-only", "full-readiness"],
      "default": "shared"
    },
    "mock_exam": {
      "type": "boolean",
      "default": true
    },
    "destructive": {
      "type": "boolean",
      "default": false
    },
    "isolation": {
      "enum": [
        "namespace",
        "cluster-scope",
        "node-exclusive",
        "control-plane-exclusive",
        "file-only",
        "disposable-cell"
      ]
    },
    "designated_host": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]{0,62}$"
    },
    "ssh_profile": {
      "enum": [
        "kubectl",
        "network-probe",
        "node-admin",
        "control-plane-admin",
        "operator-admin",
        "gateway-admin"
      ]
    },
    "answer_files": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9._/-]+$"
      },
      "uniqueItems": true,
      "default": []
    },
    "mutex_keys": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true,
      "default": []
    },
    "breaks": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true,
      "default": []
    },
    "requires": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true,
      "default": []
    },
    "setup_timeout_seconds": {
      "type": "integer",
      "minimum": 1
    },
    "grade_timeout_seconds": {
      "type": "integer",
      "minimum": 1
    },
    "validate_setup": {
      "type": "string",
      "minLength": 1
    },
    "initial_expected": {
      "type": "object",
      "additionalProperties": {
        "enum": ["PASS", "FAIL", "INVALID"]
      }
    }
  }
}
